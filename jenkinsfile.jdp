pipeline {
    agent any
    stages {
        stage('pull'){
            steps {
                git branch: 'dev', url: 'https://github.com/prathmeshkaral/BACKEND.git'
            }
        }
        stage('build'){
            steps {
                sh '/opt/apache-maven-3.9.9/bin/mvn clean package -Dmaven.test.skip=true'
            }
        }
        stage('docker-build'){
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-cred', passwordVariable: 'passwd', usernameVariable: 'uname')]) {
                sh 'docker login -u "$uname" -p "$passwd"'
                sh 'docker build . -t prathmesh72/b18-backend:latest'
                sh 'docker push prathmesh72/b18-backend:latest'
                }
            }
        }
        stage('deploy'){
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'AWS cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh 'aws eks update-kubeconfig --region us-east-1 --name dyl-cluster'
                sh 'kubectl apply -f ./yaml/'
                }
            }
        }
    }
}
